{
  "expo": {
    "name": "FLICK",
    "slug": "flick-film-journal",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "flick",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d701494e-4875-45b4-b9c4-feb15dac3e85"
      }
    }
  }
}
