{
  "name": "flick-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "node scripts/security-compat.mjs",
    "prestart": "npm run security:secrets",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "preweb": "npm run security:secrets",
    "web": "expo start --web",
    "build:web": "node scripts/security-compat.mjs --check && npm run security:secrets && expo export --platform web && node scripts/build-pwa.mjs && npm run security:secrets -- --build",
    "security:audit": "npm audit --audit-level=moderate",
    "security:secrets": "node scripts/secrets-guard.mjs",
    "catalog:audit": "node scripts/audit-tmdb-catalog.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "vitest run",
    "check": "node scripts/security-compat.mjs --check && npm run security:secrets && npm run typecheck && npm run lint && npm test"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "overrides": {
    "query-string@7.1.3": {
      "decode-uri-component": "0.5.0"
    },
    "image-size": "2.0.3",
    "xcode@3.0.1": {
      "uuid": "11.1.1"
    },
    "zod": "4.6.6"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.112.2",
    "expo": "~57.0.11",
    "expo-constants": "~57.0.9",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.11",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~57.0.1",
    "typescript": "~6.0.3",
    "vitest": "~4.1.12"
  }
}
